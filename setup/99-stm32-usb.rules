# udev rule — STM32F7 via USB-to-TTL converter
# Creates stable symlink:  /dev/stm32
#
# NOTE: The RPLidar A1 also uses a CP2102 (10c4:ea60).
# The rplidar rule (99-rplidar.rules) claims that device by product string.
# The CP2102 entry here is excluded — add a serial-based rule once you know
# your STM32 adapter's USB serial:
#   udevadm info -n /dev/ttyUSB1 --attribute-walk | grep serial
#
# To find your converter's idVendor / idProduct:
#   1. Unplug RPLidar, plug in STM32 USB-TTL cable
#   2. Run:  lsusb   and   ls /dev/ttyUSB*
#   3. Run:  udevadm info -n /dev/ttyUSBx --attribute-walk | grep -E "Vendor|Product|serial"

# CH340 (WCH) — common on cheap USB-TTL modules
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
    SYMLINK+="stm32", MODE="0666", GROUP="dialout"

# FTDI FT232
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", \
    SYMLINK+="stm32", MODE="0666", GROUP="dialout"

# Prolific PL2303
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", \
    SYMLINK+="stm32", MODE="0666", GROUP="dialout"

# CP2102 with specific USB serial — fill in YOUR_SERIAL after running:
#   udevadm info -n /dev/ttyUSBx --attribute-walk | grep ATTRS{serial}
# SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
#     ATTRS{serial}=="YOUR_SERIAL", \
#     SYMLINK+="stm32", MODE="0666", GROUP="dialout"
