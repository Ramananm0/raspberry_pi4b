<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="terrain_bot">

  <!-- ── Dimensions ── -->
  <xacro:property name="base_l"   value="0.30"/>
  <xacro:property name="base_w"   value="0.20"/>
  <xacro:property name="base_h"   value="0.06"/>
  <xacro:property name="wheel_r"  value="0.065"/>
  <xacro:property name="wheel_w"  value="0.04"/>
  <xacro:property name="chassis_h" value="0.02"/>

  <!-- ── Materials ── -->
  <material name="dark_gray"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="orange">   <color rgba="0.9 0.4 0.0 1"/></material>
  <material name="black">    <color rgba="0.1 0.1 0.1 1"/></material>
  <material name="silver">   <color rgba="0.7 0.7 0.7 1"/></material>
  <material name="red">      <color rgba="0.8 0.1 0.1 1"/></material>

  <!-- ══════════════════════════════════════════
       BASE LINK — main chassis plate
  ══════════════════════════════════════════ -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_r}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>

    <!-- Main chassis plate -->
    <visual>
      <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry><box size="${base_l} ${base_w} ${base_h}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry><box size="${base_l} ${base_w} ${base_h}"/></geometry>
    </collision>

    <!-- Front bumper -->
    <visual>
      <origin xyz="${base_l/2} 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.02 ${base_w + 0.02} ${base_h}"/></geometry>
      <material name="orange"/>
    </visual>

    <!-- Rear bumper -->
    <visual>
      <origin xyz="${-base_l/2} 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.02 ${base_w + 0.02} ${base_h}"/></geometry>
      <material name="orange"/>
    </visual>

    <!-- Left side rail -->
    <visual>
      <origin xyz="0 ${base_w/2 + 0.005} ${base_h + 0.01}" rpy="0 0 0"/>
      <geometry><box size="${base_l - 0.04} 0.01 0.02"/></geometry>
      <material name="orange"/>
    </visual>

    <!-- Right side rail -->
    <visual>
      <origin xyz="0 ${-base_w/2 - 0.005} ${base_h + 0.01}" rpy="0 0 0"/>
      <geometry><box size="${base_l - 0.04} 0.01 0.02"/></geometry>
      <material name="orange"/>
    </visual>

    <!-- Electronics box on top -->
    <visual>
      <origin xyz="-0.03 0 ${base_h + 0.025}" rpy="0 0 0"/>
      <geometry><box size="0.12 0.14 0.05"/></geometry>
      <material name="dark_gray"/>
    </visual>

  </link>

  <!-- ══════════════════════════════════════════
       WHEEL MACRO — rim + tyre look
  ══════════════════════════════════════════ -->
  <xacro:macro name="wheel" params="name x y reflect">
    <link name="${name}_link">
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>

      <!-- Outer tyre -->
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"/>
      </visual>

      <!-- Inner rim -->
      <visual>
        <origin xyz="0 ${reflect * 0.005} 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_r * 0.6}" length="${wheel_w * 0.6}"/></geometry>
        <material name="silver"/>
      </visual>

      <!-- Hub centre -->
      <visual>
        <origin xyz="0 ${reflect * 0.01} 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_r * 0.15}" length="${wheel_w * 0.3}"/></geometry>
        <material name="dark_gray"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="wheel_fl" x="${base_l/2 - 0.05}"  y="${base_w/2 + wheel_w/2}"  reflect="1"/>
  <xacro:wheel name="wheel_fr" x="${base_l/2 - 0.05}"  y="${-(base_w/2 + wheel_w/2)}" reflect="-1"/>
  <xacro:wheel name="wheel_rl" x="${-(base_l/2 - 0.05)}" y="${base_w/2 + wheel_w/2}"  reflect="1"/>
  <xacro:wheel name="wheel_rr" x="${-(base_l/2 - 0.05)}" y="${-(base_w/2 + wheel_w/2)}" reflect="-1"/>

  <!-- ══════════════════════════════════════════
       IMU LINK
  ══════════════════════════════════════════ -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 ${base_h}" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════
       CAMERA MOUNT
  ══════════════════════════════════════════ -->
  <link name="camera_mount_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <!-- Mount pole -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.06"/></geometry>
      <material name="silver"/>
    </visual>
    <!-- Camera body -->
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry><box size="0.04 0.03 0.025"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- Camera lens -->
    <visual>
      <origin xyz="0.022 0 0.065" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.008" length="0.01"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.05 0.04 0.08"/></geometry>
    </collision>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_mount_link"/>
    <origin xyz="${base_l/2 - 0.04} 0 ${base_h}" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════
       LIDAR LINK
  ══════════════════════════════════════════ -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <!-- LiDAR base -->
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.03"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- LiDAR top dome -->
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.015"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="-0.05 0 ${base_h + 0.05}" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════
       GAZEBO — CAMERA SENSOR
  ══════════════════════════════════════════ -->
  <gazebo reference="camera_mount_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_mount_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60° -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ══════════════════════════════════════════
       GAZEBO — DIFF DRIVE
  ══════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>${base_w + wheel_w}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

<!-- ══════════════════════════════════════════
     GAZEBO — ICM-20948 IMU (real specs)
     Gyro noise:  0.015 dps/√Hz @ 100Hz = 0.00261 rad/s
     Accel noise: 230 µg/√Hz  @ 100Hz = 0.000230 m/s²
══════════════════════════════════════════ -->
<gazebo reference="imu_link">
  <sensor name="icm20948_imu" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <topic>imu/data</topic>
    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.00261</stddev>
            <bias_mean>0.0001</bias_mean>
            <bias_stddev>0.00001</bias_stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.00261</stddev>
            <bias_mean>0.0001</bias_mean>
            <bias_stddev>0.00001</bias_stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.00261</stddev>
            <bias_mean>0.0001</bias_mean>
            <bias_stddev>0.00001</bias_stddev>
          </noise>
        </z>
      </angular_velocity>
      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.000230</stddev>
            <bias_mean>0.001</bias_mean>
            <bias_stddev>0.0001</bias_stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.000230</stddev>
            <bias_mean>0.001</bias_mean>
            <bias_stddev>0.0001</bias_stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.000230</stddev>
            <bias_mean>0.001</bias_mean>
            <bias_stddev>0.0001</bias_stddev>
          </noise>
        </z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

  <!-- ══════════════════════════════════════════
       GAZEBO — 2D LIDAR
  ══════════════════════════════════════════ -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
