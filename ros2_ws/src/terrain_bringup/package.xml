<?xml version="1.0"?>
<package format="3">
  <name>terrain_bringup</name>
  <version>1.0.0</version>
  <description>Launch files for terrain_bot on Raspberry Pi 4B</description>
  <maintainer email="ramana@terrain_bot">Ramana</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>
  <exec_depend>terrain_odom</exec_depend>
  <exec_depend>terrain_ai</exec_depend>
  <exec_depend>terrain_robot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
